{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustMVC",
  "version": "0.1.0",
  "identifier": "com.rustmvc.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "main-window",
          "windows": ["main"],
          "permissions": []
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["desktop/icons/icon.png", "desktop/icons/icon.ico"]
  }
}
