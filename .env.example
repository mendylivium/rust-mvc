APP_NAME=RustMVC
APP_HOST=127.0.0.1
APP_PORT=3000
# sqlite, mysql, or pgsql (PostgreSQL). See docs/DATABASES.md.
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
# Leave empty for driver default: MySQL 3306, PostgreSQL 5432.
DB_PORT=
# SQLite: file path. MySQL/PostgreSQL: database name (e.g. rustmvc).
DB_DATABASE=storage/database.sqlite
DB_USERNAME=rustmvc
DB_PASSWORD=
# Optional TLS mode for server databases; see docs/DATABASES.md.
DB_SSLMODE=
# Optional explicit override; leave unset when using DB_* settings.
# DATABASE_URL=
# Enable behind HTTPS in production.
COOKIE_SECURE=false
RUST_LOG=rust_mvc=info,tower_http=info
# Required only for ./forge db:seed (at least 12 characters).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Docker Compose: host binding; the container always listens on port 3000.
DOCKER_BIND_IP=127.0.0.1
DOCKER_PORT=8080
