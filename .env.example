APP_NAME=RustMVC
APP_HOST=127.0.0.1
APP_PORT=3000
DATABASE_URL=sqlite://storage/database.sqlite
# Enable behind HTTPS in production.
COOKIE_SECURE=false
RUST_LOG=rust_mvc=info,tower_http=info
# Required only for ./forge db:seed (at least 12 characters).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
